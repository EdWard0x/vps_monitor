# GitHub Actions 默认发布到 GitHub Container Registry。
REGISTRY=ghcr.io
IMAGE_NAMESPACE=edward0x
# 推荐每次发布使用不可变版本号，例如 2026.09.10-1；也可以使用 latest。
IMAGE_TAG=v1.0.0

APP_DOMAIN=monitor.hiding.top
NGINX_NETWORK=nginx
TZ=Asia/Shanghai

POSTGRES_USER=vps_monitor
POSTGRES_DB=vps_monitor
# 建议使用仅含 URL 安全字符的高强度随机值，因为该值会嵌入 DATABASE_URL。
POSTGRES_PASSWORD=replace_with_a_long_random_password

# 以下四项必须各不相同，且至少 32 字节。部署更新时不要重新生成，否则会使会话失效。
JWT_ACCESS_SECRET=replace_with_at_least_32_random_bytes_access
JWT_REFRESH_SECRET=replace_with_at_least_32_random_bytes_refresh
CSRF_SECRET=replace_with_at_least_32_random_bytes_csrf
CURSOR_SECRET=replace_with_at_least_32_random_bytes_cursor

PROCESSOR_URL=http://flaresolverr:8191/v1
TRUSTED_PROXIES=
MIGRATE_ON_START=true

DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
WORKER_SCAN_SECONDS=5
WORKER_CONCURRENCY=10
WORKER_MERCHANT_CONCURRENCY=2
