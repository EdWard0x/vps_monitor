# GitHub Actions 默认发布到 GitHub Container Registry。
REGISTRY=ghcr.io
IMAGE_NAMESPACE=edward0x
# 推荐每次发布使用不可变版本号，例如 2026.09.10-1；也可以使用 latest。
IMAGE_TAG=v1.0.0

APP_DOMAIN=monitor.hiding.top
NGINX_NETWORK=nginx
TZ=Asia/Shanghai
APP_MODE=runtime

POSTGRES_USER=vps_monitor
POSTGRES_DB=vps_monitor
# 建议使用仅含 URL 安全字符的高强度随机值，因为该值会嵌入 DATABASE_URL。
POSTGRES_PASSWORD=replace_with_a_long_random_password

# 以下三项必须各不相同，且至少 32 字节。切换密钥会使已有令牌失效。
JWT_ACCESS_SECRET=replace_with_at_least_32_random_bytes_access
JWT_REFRESH_SECRET=replace_with_at_least_32_random_bytes_refresh
CSRF_SECRET=replace_with_at_least_32_random_bytes_csrf
CSRF_TOKEN_TTL_MINUTES=120
CSRF_COOKIE_NAME=__Host-vps_csrf
CSRF_COOKIE_SECURE=true

TRUSTED_PROXIES=
RATE_LIMIT_ENABLED=true
MIGRATE_ON_START=false

REDIS_PASSWORD=
REDIS_DB=0
FROZEN_CACHE_TTL_SECONDS=300
STOCK_STREAM=stock:observations
STOCK_CONSUMER_GROUP=vps-monitor
STOCK_CONSUMER_NAME=worker-1

DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
WORKER_ENABLED=false
START_WORKER=false
# Optional mail verification; set true and fill all SMTP settings to enable sending.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=10
