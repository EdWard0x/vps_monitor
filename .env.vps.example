# GitHub Actions 默认发布到 GitHub Container Registry。
REGISTRY=ghcr.io
IMAGE_NAMESPACE=edward0x
# 填写已发布的同一版本标签；dev 手动构建只生成 sha-*，不会更新 latest。
IMAGE_TAG=sha-920307a

APP_DOMAIN=monitor.hiding.top
NGINX_NETWORK=nginx
TZ=Asia/Shanghai

POSTGRES_USER=vps_monitor
POSTGRES_DB=vps_monitor
# 建议使用仅含 URL 安全字符的高强度随机值，因为该值会嵌入 DATABASE_URL。
POSTGRES_PASSWORD=replace_with_a_long_random_password

# 以下三项必须各不相同，且至少 32 字节。切换密钥会使已有令牌失效。
JWT_ACCESS_SECRET=replace_with_at_least_32_random_bytes_access
JWT_REFRESH_SECRET=replace_with_at_least_32_random_bytes_refresh
CSRF_SECRET=replace_with_at_least_32_random_bytes_csrf

TRUSTED_PROXIES=

# Redis 同时保存收藏和队列，请使用独立的随机密码。
REDIS_PASSWORD=replace_with_a_long_random_redis_password
# 默认连接同一 Compose 项目中的 FlareSolverr；外部部署时改为容器可达的地址。
FLARE_RESOLVER_URL=http://flaresolverr:8191/v1

# 邮件验证和密码找回使用 SMTP；启用时填写以下字段。
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=10
