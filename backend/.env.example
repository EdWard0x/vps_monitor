# Application
APP_ENV=development
# runtime 连接真实 PostgreSQL/Redis；skeleton 仅用于无依赖检查。
APP_MODE=runtime
HTTP_ADDR=:8080
FRONTEND_ORIGINS=http://localhost:5173
TRUSTED_PROXIES=
RATE_LIMIT_ENABLED=true

# PostgreSQL
DATABASE_URL=postgres://vps_monitor:vps_monitor_dev@127.0.0.1:5432/vps_monitor_dev?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5

# Redis and stock stream
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
FROZEN_CACHE_TTL_SECONDS=300
STOCK_STREAM=stock:observations
STOCK_CONSUMER_GROUP=vps-monitor
# 同时运行多个 worker 时，每个实例必须使用不同的 consumer 名称。
STOCK_CONSUMER_NAME=worker-1

# Authentication and CSRF. Three secrets must be different and at least 32 bytes.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-bytes-refresh
JWT_ISSUER=vps-monitor
JWT_ACCESS_AUDIENCE=vps-monitor-api
JWT_REFRESH_AUDIENCE=vps-monitor-refresh
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168
CSRF_SECRET=replace-with-at-least-32-random-bytes-csrf
CSRF_TOKEN_TTL_MINUTES=120
CSRF_COOKIE_NAME=vps_csrf
CSRF_COOKIE_SECURE=false

# SMTP. MAIL_ENABLED=true requires host, from, a valid port and TLS mode.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=10

# Stock collection worker.
# 启用前需要在 STOCK_STREAM 上创建 STOCK_CONSUMER_GROUP。
# 本地运行 cmd/worker 只需 WORKER_ENABLED=true；Docker 入口还需 START_WORKER=true。
WORKER_ENABLED=false
START_WORKER=false
WORKER_READ_COUNT=10
WORKER_BLOCK_SECONDS=5

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Docker entrypoint only. Local go run does not automatically execute migrations.
MIGRATE_ON_START=false
