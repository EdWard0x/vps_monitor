APP_ENV=development
# runtime 提供真实业务；skeleton 仅用于无依赖的路由检查。
APP_MODE=runtime
HTTP_ADDR=:8080
FRONTEND_ORIGINS=http://localhost:5173
TRUSTED_PROXIES=
RATE_LIMIT_ENABLED=true

DATABASE_URL=postgres://vps_monitor:vps_monitor_dev@127.0.0.1:5432/vps_monitor_dev?sslmode=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
FROZEN_CACHE_TTL_SECONDS=300
STOCK_STREAM=stock:observations
STOCK_CONSUMER_GROUP=vps-monitor
STOCK_CONSUMER_NAME=worker-1

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-bytes-refresh
JWT_ISSUER=vps-monitor
JWT_ACCESS_AUDIENCE=vps-monitor-api
JWT_REFRESH_AUDIENCE=vps-monitor-refresh
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168
CSRF_SECRET=replace-with-at-least-32-random-bytes-csrf
CSRF_TOKEN_TTL_MINUTES=120
CSRF_COOKIE_NAME=vps_csrf
CSRF_COOKIE_SECURE=false

MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=10

# 采集和库存更新由维护者后续实现；当前保持关闭。
WORKER_ENABLED=false
WORKER_READ_COUNT=10
WORKER_BLOCK_SECONDS=5
LOG_LEVEL=info
LOG_FORMAT=json
MIGRATE_ON_START=false
